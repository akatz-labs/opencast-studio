  "outputs": {
    "anchor": "248",
    "video": "23"
  },
  "comfyui_revision": "63be2f9b82ad0dac88a7ceaa28a9cf3154125a18",
  "api_usage": "Upload assets with ComfyUI, set the returned filenames at these input nodes, use unique filename_prefix values on output nodes 248 and 23, then submit the API graph. Preserve nested execution IDs. For anchor-only execution select the anchor-component template. Do not require a background file for character-swap.",
  "automatic_timing": {
    "source_cap_seconds": 15,
    "source_fps_node": "1102:output 2",
    "frame_count_node": "1104:output 1",
    "formula": "max(5, 5 + 17 * floor((floor(min(15, source_frames / source_fps) * 24 + 0.000001) - 5) / 17))",
    "output_fps": 24,
    "maximum_output_frames": 345,
    "maximum_output_seconds": 14.375,
    "note": "Native minimum is five frames. Use 24 fps source video for faithful motion reference; duration calculation itself uses the source FPS. Anchor remains five generated frames, selected frame 0."
  }
}